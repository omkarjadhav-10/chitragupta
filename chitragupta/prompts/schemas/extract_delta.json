{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "api_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "claude_session",
              "bruno",
              "http_file",
              "inbox"
            ]
          },
          "method": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "headers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "response_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outcome": {
            "type": "string",
            "enum": [
              "worked",
              "failed",
              "unknown"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "auth",
              "setup",
              "trigger",
              "verify",
              "cleanup",
              "exploratory"
            ]
          },
          "scenario": {
            "type": "string"
          },
          "critical_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "string"
          },
          "auth_mechanism": {
            "type": "string",
            "enum": [
              "bearer",
              "cookie",
              "api_key",
              "basic",
              "none"
            ]
          },
          "pinned": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "at",
          "source",
          "method",
          "url",
          "headers",
          "body",
          "status",
          "response_keys",
          "outcome",
          "role",
          "scenario",
          "critical_fields",
          "expected",
          "auth_mechanism",
          "pinned",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "data_flow": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": [
              "string",
              "null"
            ]
          },
          "scenario": {
            "type": "string"
          },
          "step": {
            "type": [
              "integer",
              "null"
            ]
          },
          "trigger": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "select",
              "insert",
              "update",
              "delete",
              "upsert",
              "merge",
              "proc"
            ]
          },
          "table": {
            "type": "string"
          },
          "columns_read": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "columns_written": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "column": {
                  "type": "string"
                },
                "change": {
                  "type": "string"
                },
                "condition": {
                  "type": "string"
                }
              },
              "required": [
                "column",
                "change",
                "condition"
              ],
              "additionalProperties": false
            }
          },
          "via": {
            "type": "string",
            "enum": [
              "JPA/EF entity",
              "repository",
              "native SQL",
              "stored proc",
              "DB trigger",
              "integration engine DB writer",
              "other"
            ]
          },
          "transaction": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "confirmed",
              "likely",
              "hypothesis"
            ]
          }
        },
        "required": [
          "ticket",
          "scenario",
          "step",
          "trigger",
          "component",
          "operation",
          "table",
          "columns_read",
          "columns_written",
          "via",
          "transaction",
          "evidence",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "table_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fk",
              "join",
              "logical"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "from",
          "to",
          "kind",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "ticket": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "doc",
              "html",
              "diagram",
              "payload",
              "query",
              "request",
              "script",
              "export",
              "screenshot",
              "document",
              "link"
            ]
          },
          "purpose": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "ticket",
          "kind",
          "purpose"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "api_calls",
    "data_flow",
    "table_relations",
    "artifacts"
  ],
  "additionalProperties": false
}