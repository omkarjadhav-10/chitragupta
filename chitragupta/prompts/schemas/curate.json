{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "call_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "why_needed": {
                  "type": "string"
                },
                "expected": {
                  "type": "string"
                },
                "critical_fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "auth",
                    "setup",
                    "trigger",
                    "verify",
                    "cleanup"
                  ]
                },
                "verify_query": {
                  "type": "string"
                },
                "repeat_of_step": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "request": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "method": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "headers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "value": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "name",
                              "value"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "body": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "method",
                        "url",
                        "headers",
                        "body"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "call_id",
                "name",
                "purpose",
                "why_needed",
                "expected",
                "critical_fields",
                "role",
                "verify_query",
                "repeat_of_step",
                "request"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "summary",
          "steps"
        ],
        "additionalProperties": false
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "call_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "call_id",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "scenarios",
    "dropped"
  ],
  "additionalProperties": false
}