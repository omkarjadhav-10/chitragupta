{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "root_cause": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "string",
          "enum": [
            "none",
            "hypothesis",
            "likely",
            "confirmed"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "text",
              "cites"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "confidence",
        "claims"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "label": {
                "type": "string",
                "enum": [
                  "",
                  "ruled-out"
                ]
              }
            },
            "required": [
              "text",
              "cites",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "claims"
      ],
      "additionalProperties": false
    },
    "before": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "text",
              "cites"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    },
    "proposed": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "text",
              "cites"
            ],
            "additionalProperties": false
          }
        },
        "rejected": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "cites": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "text",
            "cites"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "claims",
        "rejected"
      ],
      "additionalProperties": false
    },
    "fixes_made": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "cites": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "text",
            "cites"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "after": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "text",
              "cites"
            ],
            "additionalProperties": false
          }
        },
        "verified": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "not-verified",
                "verified"
              ]
            },
            "text": {
              "type": "string"
            },
            "cites": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "state",
            "text",
            "cites"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "steps",
        "verified"
      ],
      "additionalProperties": false
    },
    "cons": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "label": {
                "type": "string",
                "enum": [
                  "suggested",
                  "recorded"
                ]
              }
            },
            "required": [
              "text",
              "cites",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "claims"
      ],
      "additionalProperties": false
    },
    "relevance": {
      "type": "object",
      "properties": {
        "queries": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "cause",
                  "fix-design",
                  "verify"
                ]
              }
            },
            "required": [
              "id",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "tables": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string"
          }
        },
        "apis": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "relevance": {
                "type": "string",
                "enum": [
                  "core",
                  "supporting",
                  "noise"
                ]
              }
            },
            "required": [
              "id",
              "relevance"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "queries",
        "tables",
        "apis",
        "scenarios"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "unknowns": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 280
              },
              "cites": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "text",
              "cites"
            ],
            "additionalProperties": false
          }
        },
        "next_action": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 280
            },
            "cites": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "text",
            "cites"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "unknowns",
        "next_action"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "root_cause",
    "findings",
    "before",
    "proposed",
    "fixes_made",
    "after",
    "cons",
    "relevance",
    "summary"
  ]
}
