{
  "description": "Chitragupta: capture Claude Code session events into the worklog, and warn when a branch or PR doesn't fit the repo's strategy. Every hook fails open (exit 0).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "Bash(git checkout *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "Bash(git switch *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "Bash(git branch *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "Bash(git -C *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "Bash(gh pr create*)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "Bash(glab mr create*)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "Bash(az repos pr create*)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "PowerShell(git checkout *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "PowerShell(git switch *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "PowerShell(git branch *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "PowerShell(git -C *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "PowerShell(gh pr create*)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "PowerShell(glab mr create*)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "pre-tool"
            ],
            "if": "PowerShell(az repos pr create*)",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pyw",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "user-prompt"
            ],
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Read|WebFetch|Artifact|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pyw",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "post-tool"
            ],
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pyw",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "stop"
            ],
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pyw",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.py",
              "hook",
              "session-end"
            ],
            "async": true
          }
        ]
      }
    ]
  }
}
